# Copy to .env and fill in real values.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ndrf:ndrf@localhost:5432/ndrf
# 管理員登入（直接比對密碼字串，不需 bcrypt hash；設定長且唯一的密碼）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
SESSION_TTL_HOURS=8
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
TRUST_PROXY=true
APP_TIMEZONE=Asia/Hong_Kong
IP_RETENTION_DAYS=365
MAX_UPLOAD_MB=5
MAX_IMPORT_ROWS=1000
CORS_ORIGINS=
CSRF_ENABLED=true
