# Copy to .env and fill in real values.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ndrf:ndrf@localhost:5432/ndrf
# 管理員登入（直接比對密碼字串，不需 bcrypt hash；設定長且唯一的密碼）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
SESSION_TTL_HOURS=8
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
# Trust exactly one reverse proxy hop in production. Set TRUST_PROXY=false locally.
TRUST_PROXY=true
TRUST_PROXY_HOPS=1
APP_TIMEZONE=Asia/Hong_Kong
IP_RETENTION_DAYS=365
MAX_UPLOAD_MB=5
MAX_IMPORT_ROWS=1000
# 正式匯出 Excel 保存日數；預設三個月
EXPORT_FILE_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=730
LOGIN_ATTEMPT_RETENTION_DAYS=90
IMPORT_BATCH_RETENTION_DAYS=730
EXPORT_BATCH_RETENTION_DAYS=730
# 「搵返申請編號」Recovery Code 於管理後台「Recovery Code 管理」設定（每組 OM 獨立 + master），唔使環境變數。
# Return schedule is maintained outside source code and can be replaced yearly.
RETURN_SCHEDULE_PATH=./return-schedule.json
RETURN_ENFORCEMENT_START=2026-08-01
CORS_ORIGINS=
CSRF_ENABLED=true

# 伺服器端獨立暫停公開提交、修改及 Excel 匯入；日後重新開通時設為 false。
PUBLIC_WRITE_SUSPENSION_ENABLED=true
PUBLIC_WRITE_SUSPENSION_AT=2026-08-11T23:59:59+08:00

# 一般 NDRF Portal（Store/Buyer/SCT 帳戶）啟用開關。只影響 Store 新提交/上載；
# Admin 管理、審批、匯出及 override 不受此開關限制。
NORMAL_NDRF_PORTAL_ENABLED=true
# 前台 Portal 暫時免密碼開關：設為 true 時，店舖／Buyer／SCT 只需輸入使用者名稱
# 即可登入，所有前台服務照常用，強制改密碼檢查會跳過。密碼 hash 會保留，
# 還原時設回 false 即恢復密碼登入。後台 Admin 永不受影響，必須保持密碼登入。
PORTAL_AUTH_BYPASS=false
# Reject 後可重新申請的冷卻時數（預設 30 x 24 小時）
NDRF_REJECT_COOLDOWN_HOURS=720

# Buyer SLA：Buyer 須於 N 日內完成 ND 審批，逾期未有回覆由系統視為默認同意（自動批准）
NDRF_AUTO_APPROVE_ENABLED=true
NDRF_AUTO_APPROVE_DAYS=7